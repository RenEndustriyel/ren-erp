                className="def-timeline-row def-clickable-row"
                key={invoice.id}
                onClick={() => openInvoiceDetail(invoice)}
              >
                <div className="def-timeline-dot green">
                  {days === null ? "–" : days < 0 ? "!" : days}
                </div>
                <div className="def-timeline-info">
                  <strong>{customerOf(invoice, customers)}</strong>
                  <span>
                    {invoice.invoiceNo || "Fatura"} ·{" "}
                    {days === null
                      ? "Planlanmadı"
                      : days < 0
                      ? `${Math.abs(days)} gün gecikmiş`
                      : days === 0
                      ? "Bugün"
                      : `${days} gün`}
                  </span>
                </div>
                <b>₺{money(remainingForInvoice(invoice))}</b>
