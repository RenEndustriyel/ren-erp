                      ? "Planlanmadı"
                      : days < 0
                      ? `${Math.abs(days)} gün gecikmiş`
                      : days === 0
                      ? "Bugün"
                      : `${days} gün`}
                  </span>
                </div>
                <b>₺{money(remainingForInvoice(invoice))}</b>
              </button>
            );
          })
        ) : (
          <EmptyState>Bekleyen ödeme yok</EmptyState>
        )}
      </section>
    ),

    shortcuts: (
      <section className="def-module-card def-side-card">
        <div className="def-side-heading">
          <div>
            <span className="def-module-kicker">HIZLI ERİŞİM</span>
            <h3>Kısa Yollar</h3>
            <span>Sık kullandığınız işlemler</span>
          </div>
        </div>

        <div className="def-shortcuts">
          <button type="button" onClick={() => openQuickAction("/invoices/new")}>
            <MdDescription />
            Yeni Fatura
          </button>
          <button type="button" onClick={() => openQuickAction("/customers/new")}>
            <MdLocalAtm />
            Cari Ekle
          </button>
          <button type="button" onClick={() => openQuickAction("/quick-sale")}>
            <MdPayments />
            Hızlı Satış
          </button>
          <button type="button" onClick={() => openQuickAction("/stock/new")}>
            <MdReceiptLong />
            Yeni Ürün
          </button>
          <button type="button" onClick={() => openQuickAction("/reports")}>
            <MdTrendingUp />
            Raporlar
          </button>
          <button type="button" onClick={() => openQuickAction("/cash-bank")}>
            <MdAccountBalance />
            Kasa / Banka
          </button>
        </div>
      </section>
    ),

    cashflow: (
      <section className="def-module-card def-cashflow-card">
        <div className="def-today-header">
          <div>
            <span>BUGÜN</span>
            <h3>Net Nakit Akışı</h3>
          </div>
          <MdMoreVert />
        </div>

        <strong className="def-today-number">
          ₺{money(netCashFlow)}
        </strong>

        <div className="def-cashflow-bar">
          <span
            style={{
              width:
                todaySales + todayPurchases > 0
                  ? `${Math.min(
                      100,
                      (todaySales / (todaySales + todayPurchases)) * 100
                    )}%`
                  : "0%",
            }}
          />
        </div>

        <div className="def-today-footer">
          <span><MdTrendingUp /> Giriş ₺{money(todaySales)}</span>
          <span><MdTrendingDown /> Çıkış ₺{money(todayPurchases)}</span>
        </div>
      </section>
    ),

    recent: (
      <section className="def-module-card def-recent-card">
        <div className="def-card-heading">
          <div>
            <span className="def-module-kicker">AKTİVİTE</span>
            <h2>Son İşlemler</h2>
            <span>Son faturalar ve finansal hareketler</span>
          </div>

          <button
            type="button"
            className="def-link-btn"
            onClick={() => openQuickAction("/invoices")}
          >
            Tüm Faturalar <MdArrowForward />
          </button>
        </div>

        <div className="def-table-wrap">
          <table>
            <thead>
              <tr>
                <th>TARİH</th>
                <th>İŞLEM</th>
                <th>AÇIKLAMA</th>
                <th>BELGE</th>
                <th>CARİ</th>
                <th>TUTAR</th>
                <th>DURUM</th>
              </tr>
            </thead>
            <tbody>
              {filteredRecent.length ? (
                filteredRecent.map((invoice) => {
                  const type = typeOf(invoice.type);
                  return (
                    <tr
                      key={invoice.id}
                      className="def-recent-row"
                      onClick={() => openInvoiceDetail(invoice)}
                    >
                      <td>{dateKey(invoice.date || invoice.createdAt)}</td>
                      <td>
                        <span className={`def-type-pill ${type}`}>
                          {type === "purchase" ? "Alış" : type === "return" ? "İade" : "Satış"}
                        </span>
                      </td>
                      <td>
                        {invoice.__quickSale
                          ? "Hızlı Satış"
                          : invoice.notes || invoice.description || "Fatura işlemi"}
                      </td>
                      <td>{invoice.invoiceNo || invoice.id}</td>
                      <td>{customerOf(invoice, customers)}</td>
                      <td className="def-amount">₺{money(totalOf(invoice))}</td>
                      <td>
                        <span className="def-status">
                          <MdCheckCircle />
                          {invoice.status || invoice.paymentStatus || "Tamamlandı"}
                        </span>
                      </td>
                    </tr>
                  );
                })
              ) : (
                <tr>
                  <td colSpan="7">
                    <EmptyState>Henüz işlem bulunmuyor.</EmptyState>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    ),
  };

  return (
    <div className="def-dashboard">
      <div className="def-dashboard-toolbar">
        <div>
          <span>GENEL BAKIŞ</span>
          <h1>İşletmenizin bugünkü özeti</h1>
        </div>

        <div className="def-layout-actions">
          <button
            type="button"
            className={moduleManagerOpen ? "active" : ""}
            onClick={() => setModuleManagerOpen((value) => !value)}
          >
            Modülleri Yönet
          </button>

          <button
            type="button"
            className={layoutEdit ? "active" : ""}
            onClick={() => setLayoutEdit((value) => !value)}
          >
            <MdDragIndicator />
            {layoutEdit ? "Düzeni Bitir" : "Düzeni Düzenle"}
          </button>

          {(layoutEdit || moduleManagerOpen) && (
            <button
              type="button"
              className="def-reset-layout"
              onClick={() => {
                resetModuleOrder();
                resetVisibleModules();
              }}
            >
              Sıfırla
            </button>
          )}
        </div>
      </div>

      {layoutEdit && (
        <div className="def-layout-hint">
          <MdDragIndicator />
          Kartları sürükleyip istediğiniz yere bırakın. Sıra otomatik kaydedilir.
        </div>
      )}

      {moduleManagerOpen && (
        <section className="def-module-manager">
          <div className="def-module-manager-head">
            <div>
              <span className="def-module-kicker">ANA SAYFA</span>
              <h2>Gösterilecek Modüller</h2>
              <p>İstemediğiniz kartları kapatabilir, daha sonra tekrar açabilirsiniz.</p>
            </div>
            <button type="button" onClick={resetVisibleModules}>
              Tümünü Göster
            </button>
          </div>

          <div className="def-module-manager-grid">
            {MODULE_CATALOG.map(([key, label]) => (
              <button
                type="button"
                key={key}
                className={visibleModules[key] ? "selected" : ""}
                onClick={() => toggleModuleVisibility(key)}
              >
                <span className="def-module-check">
                  {visibleModules[key] ? "✓" : ""}
                </span>
                <span>{label}</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <div className="def-v2-grid">
        {moduleOrder.filter((key) => visibleModules[key]).map((key) => (
          <div
            key={key}
            className={`def-dashboard-module ${key}`}
            draggable={layoutEdit}
            onDragStart={(event) => handleDragStart(event, key)}
            onDragOver={(event) => {
              if (layoutEdit) event.preventDefault();
            }}
            onDrop={(event) => handleDrop(event, key)}
            onDragEnd={() => setDraggedModule(null)}
          >
            {layoutEdit && (
              <div className="def-module-drag-handle">
                <MdDragIndicator />
                Taşı
              </div>
            )}
            {moduleContent[key]}
          </div>
        ))}
      </div>

      <div className="def-dashboard-footer">
        <span>
          <MdReceiptLong />
          {products.length} ürün
        </span>
        <span>
          <MdLocalAtm />
          {customers.length} cari
        </span>
        <span>
          <MdTrendingDown />
          {criticalStock} kritik stok
        </span>
      </div>
    </div>
  );
}
