import { useEffect, useMemo, useState } from "react";
import {
  MdAccountBalance,
  MdAdd,
  MdArrowForward,
  MdCalendarToday,
  MdCheckCircle,
  MdDescription,
  MdDragIndicator,
  MdKeyboardArrowDown,
  MdKeyboardArrowRight,
  MdLocalAtm,
  MdMoreVert,
  MdPayments,
  MdReceiptLong,
  MdSearch,
  MdTrendingDown,
  MdTrendingUp,
} from "react-icons/md";

import { getInvoices } from "../../lib/invoiceStore";
import { getCustomers } from "../../lib/customerStore";
import { getProducts } from "../../lib/stockStore";

import "./Overview.css";

const ORDER_KEY = "ren-overview-module-order-v3";

const DEFAULT_MODULE_ORDER = [
  "kpis",
  "todayActions",
  "financialStatus",
  "cashFlow",
  "cashChart",
  "invoiceChart",
  "balanceChart",
  "welcome",
  "agenda",
  "finance",
  "cash",
  "collections",
  "payments",
  "shortcuts",
  "cashflow",
  "recent",
];

const ACCOUNT_KEYS = [
  "ren-erp-cash-bank-accounts",
  "ren-finance-accounts",
  "ren-cashbank-accounts",
];

function money(value) {
  return new Intl.NumberFormat("tr-TR", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(Number(value) || 0);
}

function dateKey(value) {
  if (!value) return "";
  const raw = String(value);
  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "";

  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0"),
  ].join("-");
}

function numberValue(value) {
  if (value === null || value === undefined || value === "") return 0;
  if (typeof value === "number") return Number.isFinite(value) ? value : 0;

  const text = String(value).trim().replace(/\s/g, "");
  const normalized =
    text.includes(",") && text.includes(".")
      ? text.replace(/\./g, "").replace(",", ".")
      : text.replace(",", ".");

  const result = Number(normalized);
  return Number.isFinite(result) ? result : 0;
}

function typeOf(value) {
  const type = String(value || "")
    .trim()
    .toLocaleLowerCase("tr-TR");

  if (
    type.includes("alış") ||
    type.includes("alis") ||
    type.includes("purchase")
  ) {
    return "purchase";
  }

  if (type.includes("iade") || type.includes("return")) {
    return "return";
  }

  return "sales";
}

function totalOf(invoice) {
  return numberValue(
    invoice?.total ??
      invoice?.grandTotal ??
      invoice?.amount ??
      invoice?.totalAmount
  );
}

function basePaidOf(invoice) {
  return numberValue(
    invoice?.paidAmount ??
      invoice?.paymentAmount ??
      invoice?.paid ??
      invoice?.collectedAmount ??
      invoice?.paidAmountTotal
  );
}

function customerIdOf(invoice) {
  return invoice?.customerId ?? invoice?.supplierId ?? "";
}

function customerOf(invoice, customers) {
  if (invoice?.customerName) return invoice.customerName;
  if (invoice?.supplierName) return invoice.supplierName;

  const customer = customers.find(
    (item) => String(item.id) === String(customerIdOf(invoice))
  );

  return (
    customer?.name ||
    customer?.title ||
    customer?.companyName ||
    "Cari"
  );
}

function getAccountType(account) {
  const type = String(
    account?.type || account?.accountType || account?.kind || ""
  ).toLocaleLowerCase("tr-TR");

  if (
    type.includes("cash") ||
    type.includes("kasa") ||
    type.includes("nakit")
  ) {
    return "cash";
  }

  return "bank";
}

function getAccountName(account) {
  return (
    account?.name ||
    account?.title ||
    account?.accountName ||
    account?.bankName ||
    "Hesap"
  );
}

function getAccounts() {
  for (const key of ACCOUNT_KEYS) {
    try {
      const parsed = JSON.parse(localStorage.getItem(key) || "null");
      if (Array.isArray(parsed)) return parsed;
      if (parsed?.accounts && Array.isArray(parsed.accounts)) {
        return parsed.accounts;
      }
    } catch {
      // Ignore malformed optional storage.
    }
  }
  return [];
}

function getStoredArray(key) {
  try {
    const parsed = JSON.parse(localStorage.getItem(key) || "[]");
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

function getCollections() {
  const primary = getStoredArray("ren-erp-collections");
  const legacy = getStoredArray("ren-collections");

  const seen = new Set();
  return [...primary, ...legacy].filter((item) => {
    const key = String(item?.id ?? item?.document ?? `${item?.date}-${item?.amount}`);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

function getPayments() {
  const keys = [
    "ren-erp-payments",
    "ren-payments",
    "ren-payment-records",
  ];

  const all = [];
  const seen = new Set();

  keys.forEach((key) => {
    getStoredArray(key).forEach((item) => {
      const id = String(item?.id ?? item?.document ?? `${item?.date}-${item?.amount}`);
      if (seen.has(id)) return;
      seen.add(id);
      all.push(item);
    });
  });

  return all;
}

function dueDays(invoice, today) {
  const due = dateKey(invoice?.dueDate || invoice?.date);
  if (!due) return null;

  const a = new Date(`${today}T12:00:00`).getTime();
  const b = new Date(`${due}T12:00:00`).getTime();
  return Math.round((b - a) / 86400000);
}

function getQuickSales() {
  return getStoredArray("ren_erp_quick_sales").map((sale) => ({
    id: sale.id || `quick-${Date.now()}-${Math.random()}`,
    type: "sales",
    invoiceNo:
      sale.number ||
      sale.saleNumber ||
      sale.invoiceNo ||
      sale.id ||
      "Hızlı Satış",
    date: sale.date || sale.createdAt,
    createdAt:
      sale.createdAt ||
      `${sale.date || dateKey(new Date())}T${sale.time || "00:00"}:00`,
    customerName: sale.customerName || sale.customer || "Hızlı Satış",
    total: numberValue(
      sale.total || sale.grandTotal || sale.totalAmount
    ),
    notes: sale.notes || "Hızlı Satış",
    paymentType: sale.paymentType,
    __quickSale: true,
  }));
}

function isExplicitlyPaid(invoice) {
  const total = totalOf(invoice);
  const paid = basePaidOf(invoice);

  if (total > 0 && paid >= total - 0.005) return true;

  const status = String(
    invoice?.status || invoice?.paymentStatus || ""
  ).toLocaleLowerCase("tr-TR");

  return (
    status.includes("paid") ||
    status.includes("ödendi") ||
    status.includes("tahsil edildi") ||
    status.includes("tamamlandı") ||
    status.includes("tamamlandi")
  );
}

function EmptyState({ children }) {
  return (
    <div className="def-empty-state">
      <MdCheckCircle />
      <span>{children || "Kayıt bulunamadı."}</span>
    </div>
  );
}

export default function Overview() {
  const [refreshKey, setRefreshKey] = useState(0);
  const [now, setNow] = useState(() => new Date());
  const [agendaSearch, setAgendaSearch] = useState("");
  const [period, setPeriod] = useState("Bu ay");
  const [layoutEdit, setLayoutEdit] = useState(false);
  const [moduleManagerOpen, setModuleManagerOpen] = useState(false);
  const [draggedModule, setDraggedModule] = useState(null);

  const [moduleOrder, setModuleOrder] = useState(() => {
    try {
      const saved = JSON.parse(localStorage.getItem(ORDER_KEY) || "null");
      if (!Array.isArray(saved)) return DEFAULT_MODULE_ORDER;

      const valid = saved.filter((key) => DEFAULT_MODULE_ORDER.includes(key));
      const missing = DEFAULT_MODULE_ORDER.filter((key) => !valid.includes(key));
      return [...missing, ...valid];
    } catch {
      return DEFAULT_MODULE_ORDER;
    }
  });

  const MODULE_CATALOG = [
    ["kpis", "Kritik KPI'lar"],
    ["todayActions", "Bugün Yapılacaklar"],
    ["financialStatus", "Mali Durumunuz"],
    ["cashFlow", "Kasa Akışı"],
    ["cashChart", "Kasa Grafiği"],
    ["invoiceChart", "Fatura Grafiği"],
    ["balanceChart", "Bilanço"],
    ["welcome", "Genel Özet"],
    ["agenda", "Ajanda"],
    ["finance", "Gelir - Gider"],
    ["cash", "Kasa ve Banka"],
    ["collections", "Yaklaşan Tahsilatlar"],
    ["payments", "Yaklaşan Ödemeler"],
    ["shortcuts", "Kısa Yollar"],
    ["cashflow", "Net Nakit Akışı"],
    ["recent", "Son İşlemler"],
  ];

  const VISIBILITY_KEY = "ren-overview-module-visibility-v3";

  const [visibleModules, setVisibleModules] = useState(() => {
    try {
      const saved = JSON.parse(localStorage.getItem(VISIBILITY_KEY) || "null");
      if (!saved || typeof saved !== "object") {
        return Object.fromEntries(MODULE_CATALOG.map(([key]) => [key, true]));
      }
      return Object.fromEntries(
        MODULE_CATALOG.map(([key]) => [key, saved[key] !== false])
      );
    } catch {
      return Object.fromEntries(MODULE_CATALOG.map(([key]) => [key, true]));
    }
  });

  const toggleModuleVisibility = (key) => {
    setVisibleModules((current) => {
      const next = { ...current, [key]: current[key] !== true };
      localStorage.setItem(VISIBILITY_KEY, JSON.stringify(next));
      return next;
    });
  };

  const resetVisibleModules = () => {
    const next = Object.fromEntries(MODULE_CATALOG.map(([key]) => [key, true]));
    setVisibleModules(next);
    localStorage.setItem(VISIBILITY_KEY, JSON.stringify(next));
  };

  useEffect(() => {
    const refresh = () => {
      setNow(new Date());
      setRefreshKey((value) => value + 1);
    };

    const events = [
      "ren-invoices-updated",
      "ren-invoices-changed",
      "ren-finance-updated",
      "ren-stock-updated",
      "ren-stock-movements-changed",
      "ren-products-changed",
      "ren-customers-updated",
      "ren-customer-movements-updated",
      "ren-collections-updated",
      "ren-cash-bank-updated",
      "storage",
    ];

    events.forEach((name) => window.addEventListener(name, refresh));
    const timer = window.setInterval(refresh, 15000);

    return () => {
      events.forEach((name) => window.removeEventListener(name, refresh));
      window.clearInterval(timer);
    };
  }, []);

  const moveModule = (sourceKey, targetKey) => {
    if (!sourceKey || !targetKey || sourceKey === targetKey) return;

    setModuleOrder((current) => {
      const next = [...current];
      const from = next.indexOf(sourceKey);
      const to = next.indexOf(targetKey);

      if (from < 0 || to < 0) return current;

      next.splice(from, 1);
      next.splice(to, 0, sourceKey);

      localStorage.setItem(ORDER_KEY, JSON.stringify(next));
      return next;
    });
  };

  const resetModuleOrder = () => {
    setModuleOrder(DEFAULT_MODULE_ORDER);
    localStorage.setItem(ORDER_KEY, JSON.stringify(DEFAULT_MODULE_ORDER));
  };

  const invoices = useMemo(() => getInvoices() || [], [refreshKey]);
  const customers = useMemo(() => getCustomers() || [], [refreshKey]);
  const products = useMemo(() => getProducts() || [], [refreshKey]);
  const accounts = useMemo(() => getAccounts(), [refreshKey]);

  const collections = useMemo(() => getCollections(), [refreshKey]);
  const payments = useMemo(() => getPayments(), [refreshKey]);
  const quickSales = useMemo(() => getQuickSales(), [refreshKey]);

  const today = dateKey(now);
  const month = today.slice(0, 7);

  const salesInvoices = invoices.filter((invoice) => typeOf(invoice.type) === "sales");
  const purchaseInvoices = invoices.filter((invoice) => typeOf(invoice.type) === "purchase");

  const currentMonthSales = [...salesInvoices, ...quickSales].filter(
    (invoice) => dateKey(invoice.date || invoice.createdAt).startsWith(month)
  );

  const currentMonthPurchases = purchaseInvoices.filter(
    (invoice) => dateKey(invoice.date || invoice.createdAt).startsWith(month)
  );

  const totalIncome = currentMonthSales.reduce(
    (sum, invoice) => sum + totalOf(invoice),
    0
  );

  const totalExpense = currentMonthPurchases.reduce(
    (sum, invoice) => sum + totalOf(invoice),
    0
  );

  const profit = totalIncome - totalExpense;

  const todaySales = [...salesInvoices, ...quickSales]
    .filter((invoice) => dateKey(invoice.date || invoice.createdAt) === today)
    .reduce((sum, invoice) => sum + totalOf(invoice), 0);

  const todayPurchases = purchaseInvoices
    .filter((invoice) => dateKey(invoice.date || invoice.createdAt) === today)
    .reduce((sum, invoice) => sum + totalOf(invoice), 0);

  const cashBalance = accounts
    .filter((account) => getAccountType(account) === "cash")
    .reduce(
      (sum, account) =>
        sum +
        numberValue(
          account?.balance ?? account?.currentBalance ?? account?.amount
        ),
      0
    );

  const bankBalance = accounts
    .filter((account) => getAccountType(account) === "bank")
    .reduce(
      (sum, account) =>
        sum +
        numberValue(
          account?.balance ?? account?.currentBalance ?? account?.amount
        ),
      0
    );

  const totalCash = cashBalance + bankBalance;

  /*
   * Standalone tahsilat/ödeme kayıtlarını da dikkate al.
   * Böylece tahsilat faturaya invoiceId ile bağlanmamış olsa bile
   * dashboard'da açık bakiye doğru azalır.
   */
  const linkedCollectionByInvoice = useMemo(() => {
    const map = new Map();

    collections.forEach((item) => {
      if (!item?.invoiceId) return;
      const key = String(item.invoiceId);
      map.set(key, (map.get(key) || 0) + numberValue(item.amount));
    });

    return map;
  }, [collections]);

  const linkedPaymentByInvoice = useMemo(() => {
    const map = new Map();

    payments.forEach((item) => {
      if (!item?.invoiceId) return;
      const key = String(item.invoiceId);
      map.set(key, (map.get(key) || 0) + numberValue(item.amount));
    });

    return map;
  }, [payments]);

  const unlinkedCollectionsByCustomer = useMemo(() => {
    const map = new Map();

    collections.forEach((item) => {
      if (item?.invoiceId) return;

      const customerId = String(item?.customerId || item?.supplierId || "");
      if (!customerId) return;

      map.set(
        customerId,
        (map.get(customerId) || 0) + numberValue(item.amount)
      );
    });

    return map;
  }, [collections]);

  const unlinkedPaymentsByCustomer = useMemo(() => {
    const map = new Map();

    payments.forEach((item) => {
      if (item?.invoiceId) return;

      const customerId = String(item?.customerId || item?.supplierId || "");
      if (!customerId) return;

      map.set(
        customerId,
        (map.get(customerId) || 0) + numberValue(item.amount)
      );
    });

    return map;
  }, [payments]);

  const settlementMap = useMemo(() => {
    const map = new Map();

    const openSales = [...salesInvoices]
      .sort(
        (a, b) =>
          (dueDays(a, today) ?? 9999) - (dueDays(b, today) ?? 9999)
      );

    const openPurchases = [...purchaseInvoices]
      .sort(
        (a, b) =>
          (dueDays(a, today) ?? 9999) - (dueDays(b, today) ?? 9999)
      );

    const allocate = (list, customerMap, linkedMap, direction) => {
      const residual = new Map(customerMap);

      list.forEach((invoice) => {
        const id = String(invoice.id);
        let paid =
          basePaidOf(invoice) +
          numberValue(linkedMap.get(id));

        const customerId = String(customerIdOf(invoice) || "");
        const available = numberValue(residual.get(customerId));

        if (customerId && available > 0) {
          const remaining = Math.max(totalOf(invoice) - paid, 0);
          const used = Math.min(remaining, available);
          paid += used;
          residual.set(customerId, available - used);
        }

        map.set(`${direction}:${id}`, paid);
      });
    };

    allocate(
      openSales,
      unlinkedCollectionsByCustomer,
      linkedCollectionByInvoice,
      "collect"
    );

    allocate(
      openPurchases,
      unlinkedPaymentsByCustomer,
      linkedPaymentByInvoice,
      "pay"
    );

    return map;
  }, [
    salesInvoices,
    purchaseInvoices,
    today,
    unlinkedCollectionsByCustomer,
    unlinkedPaymentsByCustomer,
    linkedCollectionByInvoice,
    linkedPaymentByInvoice,
  ]);

  const paidForInvoice = (invoice) => {
    const key = `${typeOf(invoice.type) === "purchase" ? "pay" : "collect"}:${String(
      invoice.id
    )}`;

    const calculated = settlementMap.get(key);
    return Number.isFinite(calculated) ? calculated : basePaidOf(invoice);
  };

  const remainingForInvoice = (invoice) =>
    Math.max(totalOf(invoice) - paidForInvoice(invoice), 0);

  const openSales = salesInvoices.filter(
    (invoice) => remainingForInvoice(invoice) > 0.005
  );

  const openPurchases = purchaseInvoices.filter(
    (invoice) => remainingForInvoice(invoice) > 0.005
  );

  const collectTotal = openSales.reduce(
    (sum, invoice) => sum + remainingForInvoice(invoice),
    0
  );

  const payTotal = openPurchases.reduce(
    (sum, invoice) => sum + remainingForInvoice(invoice),
    0
  );

  const overdueCollect = openSales
    .filter((invoice) => (dueDays(invoice, today) ?? 0) < 0)
    .reduce((sum, invoice) => sum + remainingForInvoice(invoice), 0);

  const overduePay = openPurchases
    .filter((invoice) => (dueDays(invoice, today) ?? 0) < 0)
    .reduce((sum, invoice) => sum + remainingForInvoice(invoice), 0);

  const upcomingCollections = [...openSales]
    .sort(
      (a, b) =>
        (dueDays(a, today) ?? 9999) - (dueDays(b, today) ?? 9999)
    )
    .slice(0, 5);

  const upcomingPayments = [...openPurchases]
    .sort(
      (a, b) =>
        (dueDays(a, today) ?? 9999) - (dueDays(b, today) ?? 9999)
    )
    .slice(0, 5);

  const criticalStock = products.filter(
    (product) =>
      numberValue(product?.stock) <= numberValue(product?.criticalStock ?? 15)
  ).length;

  const recent = [
    ...invoices.map((invoice) => ({ ...invoice, __quickSale: false })),
    ...quickSales,
  ]
    .sort(
      (a, b) =>
        new Date(b.createdAt || b.date || 0).getTime() -
        new Date(a.createdAt || a.date || 0).getTime()
    )
    .slice(0, 8);

  const filteredRecent = recent.filter((item) => {
    const q = agendaSearch.trim().toLocaleLowerCase("tr-TR");
    if (!q) return true;

    return [
      item.invoiceNo,
      item.customerName,
      item.supplierName,
      item.notes,
      item.description,
      item.__quickSale ? "hızlı satış" : "",
    ]
      .filter(Boolean)
      .join(" ")
      .toLocaleLowerCase("tr-TR")
      .includes(q);
  });

  const recentCashAccounts = accounts.slice(0, 4).map((account) => ({
    id: account.id,
    name: getAccountName(account),
    balance: numberValue(
      account?.balance ?? account?.currentBalance ?? account?.amount
    ),
  }));

  const agendaDays = Array.from({ length: 5 }, (_, index) => {
    const day = new Date(now);
    day.setHours(0, 0, 0, 0);
    day.setDate(day.getDate() + index);
    return day;
  });

  const netCashFlow = todaySales - todayPurchases;
  const profitPercent = totalIncome > 0 ? (profit / totalIncome) * 100 : 0;
  const incomeVsExpense = totalIncome > 0 ? (totalExpense / totalIncome) * 100 : 0;

  const balanceAssets = totalCash + collectTotal;
  const balanceDebts = payTotal;
  const balanceTotal = balanceAssets + balanceDebts;
  const balanceShare =
    balanceTotal > 0 ? Math.max(0, Math.min(100, (balanceAssets / balanceTotal) * 100)) : 50;

  const openInvoiceDetail = (invoice) => {
    if (!invoice?.id) return;
    window.location.href = `/invoices/detail?id=${encodeURIComponent(invoice.id)}`;
  };

  const openQuickAction = (path) => {
    window.location.href = path;
  };

  const handleDragStart = (event, key) => {
    setDraggedModule(key);
    event.dataTransfer.effectAllowed = "move";
    event.dataTransfer.setData("text/plain", key);
  };

  const handleDrop = (event, targetKey) => {
    event.preventDefault();
    const sourceKey = draggedModule || event.dataTransfer.getData("text/plain");
    moveModule(sourceKey, targetKey);
    setDraggedModule(null);
  };



  const startOfDay = (date) => {
    const d = new Date(date);
    d.setHours(0, 0, 0, 0);
    return d;
  };

  const shiftDays = (date, amount) => {
    const d = startOfDay(date);
    d.setDate(d.getDate() + amount);
    return d;
  };

  const periodTotal = (items, from, to) =>
    items
      .filter((item) => {
        const d = startOfDay(item.date || item.createdAt || now);
        return d >= from && d < to;
      })
      .reduce((sum, item) => sum + totalOf(item), 0);

  const yesterday = shiftDays(now, -1);
  const tomorrow = shiftDays(now, 1);
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
  const nextMonthStart = new Date(now.getFullYear(), now.getMonth() + 1, 1);
  const prevMonthStart = new Date(now.getFullYear(), now.getMonth() - 1, 1);

  const allRevenueItems = [...salesInvoices, ...quickSales];
  const todayRevenue = periodTotal(allRevenueItems, startOfDay(now), tomorrow);
  const yesterdayRevenue = periodTotal(allRevenueItems, yesterday, startOfDay(now));
  const thisMonthRevenue = periodTotal(allRevenueItems, monthStart, nextMonthStart);
  const lastMonthRevenue = periodTotal(allRevenueItems, prevMonthStart, monthStart);

  const comparison = (current, previous) => {
    if (previous === 0 && current === 0) {
      return { value: 0, direction: "flat", text: "Değişim yok" };
    }
    if (previous === 0) {
      return { value: 100, direction: "up", text: "Yeni hareket" };
    }

    const value = ((current - previous) / Math.abs(previous)) * 100;
    return {
      value: Math.abs(value),
      direction: value > 0.05 ? "up" : value < -0.05 ? "down" : "flat",
      text: value > 0.05 ? "Yükseliş" : value < -0.05 ? "Düşüş" : "Değişim yok",
    };
  };

  const todayComparison = comparison(todayRevenue, yesterdayRevenue);
  const monthComparison = comparison(thisMonthRevenue, lastMonthRevenue);

  const lifetimeStart = allRevenueItems.reduce((earliest, item) => {
    const d = new Date(item.date || item.createdAt || now);
    if (Number.isNaN(d.getTime())) return earliest;
    return !earliest || d < earliest ? d : earliest;
  }, null);

  const lifetimeStartSafe = lifetimeStart ? startOfDay(lifetimeStart) : startOfDay(now);
  const lifetimeDays = Math.max(
    1,
    Math.ceil((startOfDay(now).getTime() - lifetimeStartSafe.getTime()) / 86400000) + 1
  );

  const lifetimeCurrent = periodTotal(
    allRevenueItems,
    lifetimeStartSafe,
    tomorrow
  );

  const lifetimePrevious = lifetimeDays > 1
    ? periodTotal(
        allRevenueItems,
        lifetimeStartSafe,
        startOfDay(now)
      )
    : 0;

  const lifetimeComparison = comparison(lifetimeCurrent, lifetimePrevious);

  const previousMonthPurchaseItems = purchaseInvoices.filter((invoice) => {
    const d = dateKey(invoice.date || invoice.createdAt);
    return d >= dateKey(prevMonthStart) && d < dateKey(monthStart);
  });

  const previousMonthRevenue = lastMonthRevenue;
  const previousMonthExpenses = previousMonthPurchaseItems.reduce(
    (sum, invoice) => sum + totalOf(invoice),
    0
  );
  const previousMonthProfit = previousMonthRevenue - previousMonthExpenses;

  const kpis = (
    <section className="def-module-card def-kpi-module">
      {[
        [
          "Bugün Satış",
          todayRevenue,
          todayComparison,
          "green",
          "/invoices/sales",
          "Düne göre",
        ],
        [
          "Bu Ay Satış",
          thisMonthRevenue,
          monthComparison,
          "green",
          "/invoices/sales",
          "Geçen aya göre",
        ],
        [
          "Bu Ay Kâr",
          profit,
          comparison(profit, previousMonthProfit),
          profit >= 0 ? "green" : "red",
          "/reports",
          "Geçen aya göre",
        ],
        [
          "Açık Alacak",
          collectTotal,
          null,
          "orange",
          "/customers/collections",
          "Bekleyen",
        ],
        [
          "Açık Borç",
          payTotal,
          null,
          "red",
          "/customers/payments",
          "Bekleyen",
        ],
        [
          "Kasa + Banka",
          totalCash,
          null,
          "blue",
          "/cash-bank",
          "Güncel",
        ],
      ].map(([label, value, change, tone, path, sub]) => (
        <button
          type="button"
          className={`def-kpi-card ${tone}`}
          key={label}
          onClick={() => openQuickAction(path)}
        >
          <span>{label}</span>
          <strong>₺{money(value)}</strong>
          {change ? (
            <small className={`def-kpi-change ${change.direction}`}>
              {change.direction === "up" ? "↑" : change.direction === "down" ? "↓" : "→"}{" "}
              %{Math.round(change.value)} · {sub} · {change.text}
            </small>
          ) : (
            <small>{sub}</small>
          )}
        </button>
      ))}
    </section>
  );

  const currentMonthPurchaseTotal = currentMonthPurchases.reduce(
    (sum, invoice) => sum + totalOf(invoice), 0
  );

  const todayActions = (
    <section className="def-module-card def-actions-module">
