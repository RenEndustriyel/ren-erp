          onClick={() => openQuickAction("/reports")}
        >
          Raporlar <MdKeyboardArrowRight />
        </button>
      </div>

      <div className="def-financial-grid">
        <div><span>Nakit Kasalar</span><strong>₺{money(cashBalance)}</strong></div>
        <div><span>Banka Hesapları</span><strong>₺{money(bankBalance)}</strong></div>
        <div><span>Kredi Kartları</span><strong>₺0,00</strong></div>
        <div><span>Alacaklar Toplamı</span><strong>₺{money(collectTotal)}</strong></div>
        <div><span>Borçlar Toplamı</span><strong>₺{money(payTotal)}</strong></div>
        <div><span>Stoklar Toplamı</span><strong>₺0,00</strong></div>
