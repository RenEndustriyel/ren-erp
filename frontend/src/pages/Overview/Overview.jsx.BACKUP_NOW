          <div><span>Müşteri Çek-Senet</span><strong>₺0,00</strong></div>
          <div><span>Krediler Toplamı</span><strong>₺0,00</strong></div>
        </div>
      </div>
    </section>
  );

  const cashFlowEntries = [
    ...collections.map((item) => ({
      id: `collection-${item.id}`,
      date: item.date,
      amount: numberValue(item.amount),
      label: item.customerName || "Cari",
      document: item.document || "Tahsilat",
      direction: "in",
    })),
    ...payments.map((item) => ({
      id: `payment-${item.id}`,
      date: item.date,
      amount: numberValue(item.amount),
      label: item.supplierName || item.customerName || "Tedarikçi",
      document: item.document || "Ödeme",
      direction: "out",
    })),
  ]
    .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime())
    .slice(0, 6);

  const cashFlow = (
    <section className="def-module-card def-cashflow-history">
      <div className="def-card-heading">
        <div>
          <span className="def-module-kicker">NAKİT HAREKETLERİ</span>
          <h2>Kasa Akışı</h2>
          <span>Kasaya giren ve kasadan çıkan son hareketler</span>
        </div>
        <button
          type="button"
          className="def-link-btn"
          onClick={() => openQuickAction("/cash-bank")}
        >
          Tümü <MdKeyboardArrowRight />
        </button>
      </div>

      <div className="def-cashflow-summary">
        <div>
          <span>Giriş</span>
          <strong>₺{money(collections.reduce((sum, item) => sum + numberValue(item.amount), 0))}</strong>
        </div>
        <div>
          <span>Çıkış</span>
          <strong>₺{money(payments.reduce((sum, item) => sum + numberValue(item.amount), 0))}</strong>
        </div>
        <div>
          <span>Net</span>
          <strong className={netCashFlow >= 0 ? "positive" : "negative"}>
            ₺{money(Math.abs(
              collections.reduce((sum, item) => sum + numberValue(item.amount), 0) -
              payments.reduce((sum, item) => sum + numberValue(item.amount), 0)
            ))}
          </strong>
        </div>
      </div>

      <div className="def-cashflow-list">
        {cashFlowEntries.length ? (
          cashFlowEntries.map((entry) => (
            <button
              type="button"
              className="def-cashflow-entry"
              key={entry.id}
              onClick={() =>
                entry.direction === "in"
                  ? openQuickAction("/customers/collections")
                  : openQuickAction("/customers/payments")
              }
            >
              <span className={`def-flow-icon ${entry.direction}`}>
                {entry.direction === "in" ? "↓" : "↑"}
              </span>
              <div>
                <strong>{entry.label}</strong>
                <span>
                  {entry.document} ·{" "}
                  {entry.date
                    ? new Date(`${entry.date}T00:00:00`).toLocaleDateString("tr-TR")
                    : "—"}
                </span>
              </div>
              <b className={entry.direction === "in" ? "positive" : "negative"}>
                {entry.direction === "in" ? "+" : "-"} ₺{money(entry.amount)}
              </b>
            </button>
          ))
        ) : (
          <EmptyState>Kasa akışı bulunmuyor.</EmptyState>
        )}
      </div>
    </section>
  );

