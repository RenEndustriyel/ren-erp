.bulk-page {
  min-height: 100%;
  padding: 30px;
  background: #f6f8fb;
  color: #172033;
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

.bulk-header {
  margin-bottom: 22px;
}

.breadcrumb {
  color: #7b8495;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 9px;
}

.breadcrumb span {
  margin: 0 7px;
  color: #b2b8c3;
}

.bulk-header h1 {
  margin: 0;
  font-size: 30px;
  font-weight: 750;
  letter-spacing: -0.6px;
}

.bulk-header p {
  margin: 8px 0 0;
  color: #7b8495;
  font-size: 14px;
}

.success-message {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 15px;
  margin-bottom: 14px;
  border: 1px solid #ccebdc;
  border-radius: 9px;
  background: #eefaf4;
  color: #16834b;
  font-size: 12px;
  font-weight: 700;
}

.success-message span {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #16834b;
  color: #fff;
}

.operation-card,
.products-card {
  background: #fff;
  border: 1px solid #e0e5ec;
  border-radius: 12px;
  box-shadow:
    0 3px 12px
    rgba(25, 40, 65, 0.035);
}

.operation-card {
  padding: 20px;
  margin-bottom: 14px;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.section-icon {
  width: 40px;
  height: 40px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf4ff;
  color: #1769e8;
  font-size: 19px;
  font-weight: 800;
}

.section-title h2,
.products-toolbar h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 750;
}

.section-title p,
.products-toolbar p {
  margin: 4px 0 0;
  color: #8a94a4;
  font-size: 11px;
}

.operation-grid {
  display: grid;
  grid-template-columns:
    1fr 1fr 0.8fr;
  gap: 13px;
}

.form-group label {
  display: block;
  margin-bottom: 7px;
  color: #344055;
  font-size: 11px;
  font-weight: 750;
}

.form-group select,
.value-input {
  width: 100%;
  height: 44px;
  box-sizing: border-box;
  border: 1px solid #dce2e9;
  border-radius: 8px;
  background: #fff;
  outline: 0;
}

.form-group select {
  padding: 0 11px;
  color: #273347;
  font-family: inherit;
  font-size: 13px;
}

.form-group select:focus,
.value-input:focus-within {
  border-color: #1769e8;
  box-shadow:
    0 0 0 3px
    rgba(23, 105, 232, 0.08);
}

.value-input {
  display: flex;
  align-items: center;
  overflow: hidden;
}

.value-input input {
  width: 100%;
  height: 100%;
  padding: 0 11px;
  border: 0;
  outline: 0;
  font-family: inherit;
  font-size: 13px;
  color: #202b3c;
}

.value-input span {
  padding: 0 12px;
  color: #7c8798;
  font-size: 12px;
  font-weight: 750;
}

.operation-info {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 15px;
  padding: 10px 12px;
  border-radius: 7px;
  background: #f7f9fb;
  color: #697588;
  font-size: 11px;
}

.operation-info strong {
  color: #344055;
}

.products-card {
  overflow: hidden;
}

.products-toolbar {
  min-height: 70px;
  padding: 15px 20px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e7ebf0;
}

.selected-count {
  display: flex;
  align-items: baseline;
  gap: 6px;
  color: #8a94a4;
  font-size: 11px;
}

.selected-count strong {
  color: #1769e8;
  font-size: 18px;
}

.search-row {
  padding: 13px 20px;
  display: flex;
  align-items: center;
  gap: 9px;
  border-bottom: 1px solid #edf0f4;
}

.bulk-search {
  height: 42px;
  flex: 1;
  border: 1px solid #dfe4eb;
  border-radius: 8px;
  background: #fbfcfe;
  display: flex;
  align-items: center;
  padding: 0 12px;
}

.bulk-search span {
  color: #7c8798;
  font-size: 21px;
  margin-right: 8px;
}

.bulk-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  font-family: inherit;
  font-size: 12px;
}

.select-all-button,
.clear-selection {
  height: 42px;
  padding: 0 13px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 750;
}

.select-all-button {
  border: 1px solid #d6e2f8;
  background: #f2f6fd;
  color: #1769e8;
}

.clear-selection {
  border: 1px solid #e5d8d8;
  background: #fff8f8;
  color: #c84747;
}

.product-table {
  overflow-x: auto;
}

.product-table-header,
.product-row {
  min-width: 850px;
  display: grid;
  grid-template-columns:
    45px minmax(270px, 1.8fr)
    130px 100px 100px 90px 80px;
  align-items: center;
  gap: 12px;
  padding: 0 20px;
}

.product-table-header {
  min-height: 48px;
  background: #fafbfd;
  border-bottom: 1px solid #e2e6ec;
  color: #7a8494;
  font-size: 10px;
  font-weight: 800;
}

.product-row {
  min-height: 70px;
  border-bottom: 1px solid #edf0f4;
  transition: background 0.15s ease;
}

.product-row:hover,
.product-row.selected {
  background: #f8fbff;
}

.checkbox-cell {
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-cell input {
  width: 16px;
  height: 16px;
  accent-color: #1769e8;
  cursor: pointer;
}

.product-info strong {
  display: block;
  color: #253145;
  font-size: 12px;
  font-weight: 700;
}

.product-info small {
  display: block;
  margin-top: 4px;
  color: #9aa3b1;
  font-size: 10px;
}

.brand-cell {
  color: #687487;
  font-size: 11px;
}

.price-cell {
  color: #59667a;
  font-size: 11px;
  font-weight: 650;
}

.price-cell.sale {
  color: #1769e8;
  font-weight: 750;
}

.profit-cell {
  color: #16834b;
  font-size: 11px;
  font-weight: 750;
}

.stock-cell {
  color: #273347;
  font-size: 12px;
  font-weight: 750;
}

.empty-products {
  padding: 55px;
  text-align: center;
  color: #8a94a4;
  font-size: 12px;
}

.products-footer {
  min-height: 64px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8a94a4;
  font-size: 11px;
}

.apply-button {
  min-height: 42px;
  padding: 0 18px;
  border: 0;
  border-radius: 8px;
  background: #1769e8;
  color: #fff;
  font-size: 12px;
  font-weight: 750;
  cursor: pointer;
  box-shadow:
    0 5px 15px
    rgba(23, 105, 232, 0.16);
}

.apply-button:hover:not(:disabled) {
  background: #0f5ed7;
}

.apply-button:disabled {
  background: #cbd3df;
  cursor: not-allowed;
  box-shadow: none;
}

/* MODAL */

.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(15, 24, 39, 0.48);
  backdrop-filter: blur(2px);
}

.confirm-modal {
  width: min(430px, 100%);
  padding: 27px;
  box-sizing: border-box;
  border-radius: 14px;
  background: #fff;
  text-align: center;
  box-shadow:
    0 22px 65px
    rgba(8, 20, 40, 0.22);
}

.confirm-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 15px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff5df;
  color: #d88900;
  font-size: 21px;
  font-weight: 800;
}

.confirm-modal h2 {
  margin: 0;
  color: #172033;
  font-size: 18px;
}

.confirm-modal p {
  margin: 10px 0 15px;
  color: #7b8495;
  font-size: 12px;
  line-height: 1.6;
}

.confirm-value {
  display: inline-block;
  padding: 9px 14px;
  border-radius: 7px;
  background: #edf4ff;
  color: #1769e8;
  font-size: 15px;
  font-weight: 800;
}

.confirm-actions {
  display: flex;
  justify-content: center;
  gap: 9px;
  margin-top: 22px;
}

.cancel-button,
.confirm-button {
  min-height: 41px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 750;
  cursor: pointer;
}

.cancel-button {
  border: 1px solid #dce1e8;
  background: #fff;
  color: #566173;
}

.confirm-button {
  border: 1px solid #1769e8;
  background: #1769e8;
  color: #fff;
}

.confirm-button:hover {
  background: #0f5ed7;
}

@media (max-width: 900px) {
  .bulk-page {
    padding: 20px 15px;
  }

  .operation-grid {
    grid-template-columns: 1fr;
  }

  .products-toolbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .search-row {
    align-items: stretch;
    flex-direction: column;
  }

  .bulk-search {
    width: 100%;
    box-sizing: border-box;
  }

  .select-all-button,
  .clear-selection {
    width: 100%;
  }
}