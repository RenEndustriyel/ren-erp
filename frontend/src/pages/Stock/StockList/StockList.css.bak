.ren-stock-list {
  min-height: 100vh;

  padding: 28px 30px 40px;

  box-sizing: border-box;

  background:
    linear-gradient(
      180deg,
      #f8fafc 0%,
      #f3f6f9 100%
    );

  color: #172033;

  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;
}

/* =========================================================
   HEADER
========================================================= */

.ren-stock-list-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;
}

.ren-stock-breadcrumb {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-bottom: 8px;

  color: #8793a3;

  font-size: 10px;
  font-weight: 600;
}

.ren-stock-breadcrumb strong {
  color: #344054;
}

.ren-stock-list-header h1 {
  margin: 0;

  color: #172033;

  font-size: 28px;
  font-weight: 780;

  letter-spacing: -0.03em;
}

.ren-stock-list-header p {
  margin: 7px 0 0;

  color: #8793a3;

  font-size: 11px;
}

.ren-stock-header-actions {
  display: flex;
  align-items: center;

  flex-wrap: wrap;

  justify-content: flex-end;

  gap: 8px;
}

.ren-outline-button,
.ren-excel-button,
.ren-import-button,
.ren-new-stock-button {
  height: 39px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  padding: 0 13px;

  box-sizing: border-box;

  border-radius: 7px;

  font-family: inherit;

  font-size: 9px;
  font-weight: 750;

  cursor: pointer;
}

.ren-outline-button {
  border: 1px solid #d9e2ec;

  background: #ffffff;

  color: #344054;
}

.ren-outline-button:hover {
  background: #f8fafc;
}

.ren-excel-button {
  border: 1px solid #c9e4d8;

  background: #f4fbf7;

  color: #16835e;
}

.ren-excel-button:hover {
  background: #e9f8f1;
}

.ren-import-button {
  border: 1px solid #cbdcf1;

  background: #f4f8fd;

  color: #286fc7;
}

.ren-import-button:hover {
  background: #eaf2fb;
}

.ren-new-stock-button {
  min-width: 116px;

  border: 1px solid #286fc7;

  background: #286fc7;

  color: #ffffff;

  box-shadow:
    0 5px 13px
    rgba(
      40,
      111,
      199,
      0.17
    );
}

.ren-new-stock-button:hover {
  background: #2163b7;
}

.ren-outline-button svg,
.ren-excel-button svg,
.ren-import-button svg,
.ren-new-stock-button svg {
  font-size: 16px;
}

.ren-hidden-file {
  display: none;
}

/* =========================================================
   ACTION MENU
========================================================= */

.ren-action-dropdown {
  position: relative;
}

.ren-action-menu {
  position: absolute;

  z-index: 30;

  top: calc(100% + 6px);
  right: 0;

  min-width: 190px;

  padding: 6px;

  border: 1px solid #dfe6ee;
  border-radius: 8px;

  background: #ffffff;

  box-shadow:
    0 10px 28px
    rgba(
      15,
      23,
      42,
      0.13
    );
}

.ren-action-menu button {
  width: 100%;

  min-height: 34px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 9px;

  border: 0;
  border-radius: 5px;

  background: transparent;

  color: #475467;

  font-family: inherit;

  font-size: 9px;
  font-weight: 600;

  text-align: left;

  cursor: pointer;
}

.ren-action-menu button:hover {
  background: #f3f7fb;

  color: #286fc7;
}

.ren-action-menu button svg {
  font-size: 15px;
}

/* =========================================================
   SUMMARY
========================================================= */

.ren-stock-summary {
  display: grid;

  grid-template-columns:
    repeat(
      4,
      minmax(0, 1fr)
    );

  gap: 12px;

  margin-bottom: 14px;
}

.ren-stock-summary-card {
  min-height: 82px;

  display: flex;
  align-items: center;

  gap: 11px;

  padding: 13px;

  box-sizing: border-box;

  border: 1px solid #e0e7ef;
  border-radius: 9px;

  background: #ffffff;

  box-shadow:
    0 2px 8px
    rgba(
      15,
      23,
      42,
      0.035
    );
}

.summary-icon {
  width: 37px;
  height: 37px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border-radius: 9px;

  font-size: 19px;
}

.summary-icon.blue {
  background: #eaf2fd;
  color: #286fc7;
}

.summary-icon.green {
  background: #e9f8f1;
  color: #159b71;
}

.summary-icon.orange {
  background: #fff4e4;
  color: #eb920e;
}

.summary-icon.red {
  background: #ffeded;
  color: #df3e48;
}

.ren-stock-summary-card span {
  display: block;

  color: #788597;

  font-size: 8px;
}

.ren-stock-summary-card strong {
  display: block;

  margin-top: 3px;

  color: #172033;

  font-size: 17px;
  font-weight: 780;
}

.ren-stock-summary-card small {
  display: block;

  margin-top: 2px;

  color: #a0a9b5;

  font-size: 7px;
}

.green-text {
  color: #159b71 !important;
}

.orange-text {
  color: #e89415 !important;
}

.red-text {
  color: #df3e48 !important;
}

/* =========================================================
   TOOLBAR
========================================================= */

.ren-stock-toolbar {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-bottom: 10px;
}

.ren-stock-search {
  width: 270px;
  height: 39px;

  position: relative;

  display: flex;
  align-items: center;

  border: 1px solid #dce4ec;
  border-radius: 7px;

  background: #ffffff;

  box-sizing: border-box;
}

.ren-stock-search > svg {
  margin-left: 10px;

  color: #98a4b3;

  font-size: 17px;
}

.ren-stock-search input {
  width: 100%;
  height: 100%;

  padding:
    0 34px 0 8px;

  border: 0;

  outline: none;

  background: transparent;

  color: #344054;

  font-family: inherit;

  font-size: 9px;
}

.ren-stock-search input::placeholder {
  color: #a1acb9;
}

.ren-stock-search:focus-within {
  border-color: #6da4df;

  box-shadow:
    0 0 0 3px
    rgba(
      40,
      111,
      199,
      0.07
    );
}

.ren-stock-search button {
  width: 28px;
  height: 28px;

  position: absolute;

  top: 5px;
  right: 5px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 5px;

  background: transparent;

  color: #99a4b2;

  cursor: pointer;
}

.ren-stock-search button:hover {
  background: #f0f3f6;
}

.ren-filter-button {
  height: 39px;

  display: flex;
  align-items: center;

  gap: 5px;

  padding: 0 11px;

  border: 1px solid #dce4ec;
  border-radius: 7px;

  background: #ffffff;

  color: #536174;

  font-family: inherit;

  font-size: 9px;
  font-weight: 650;

  cursor: pointer;
}

.ren-filter-button:hover,
.ren-filter-button.active {
  border-color: #bcd2ea;

  background: #f3f8fd;

  color: #286fc7;
}

.ren-filter-button svg {
  font-size: 15px;
}

/* =========================================================
   FILTER
========================================================= */

.ren-filter-panel {
  display: flex;
  align-items: flex-end;

  gap: 10px;

  margin-bottom: 10px;

  padding: 13px;

  border: 1px solid #dfe6ee;
  border-radius: 8px;

  background: #ffffff;
}

.ren-filter-panel > div {
  min-width: 190px;
}

.ren-filter-panel label {
  display: block;

  margin-bottom: 5px;

  color: #647286;

  font-size: 8px;
  font-weight: 700;
}

.ren-filter-panel select {
  width: 100%;

  height: 35px;

  padding: 0 9px;

  border: 1px solid #d7e0e9;
  border-radius: 6px;

  outline: none;

  background: #ffffff;

  color: #465468;

  font-family: inherit;

  font-size: 9px;
}

.ren-filter-panel > button {
  height: 35px;

  padding: 0 12px;

  border: 0;
  border-radius: 6px;

  background: #f1f4f7;

  color: #59687b;

  font-family: inherit;

  font-size: 8px;
  font-weight: 700;

  cursor: pointer;
}

.ren-filter-panel > button:hover {
  background: #e8edf2;
}

/* =========================================================
   TABS
========================================================= */

.ren-stock-tabs {
  min-height: 56px;

  display: flex;
  align-items: center;

  gap: 6px;

  padding: 7px;

  box-sizing: border-box;

  border: 1px solid #e0e7ef;
  border-bottom: 0;

  border-radius:
    9px
    9px
    0
    0;

  background: #ffffff;
}

.ren-stock-tabs button {
  height: 38px;

  display: flex;
  align-items: center;

  gap: 7px;

  padding: 0 13px;

  border: 1px solid transparent;
  border-radius: 6px;

  background: transparent;

  color: #657286;

  font-family: inherit;

  font-size: 9px;
  font-weight: 650;

  cursor: pointer;
}

.ren-stock-tabs button:hover {
  background: #f6f8fa;
}

.ren-stock-tabs button.active {
  border-color: #cfe0f3;

  background: #f2f7fd;

  color: #286fc7;
}

.ren-stock-tabs b {
  min-width: 23px;

  padding: 3px 5px;

  border-radius: 4px;

  background: #f0f2f5;

  color: #788596;

  font-size: 7px;
}

.ren-stock-tabs
button.active
b {
  background: #ffffff;

  color: #286fc7;
}

.dot {
  width: 7px;
  height: 7px;

  display: inline-block;

  border-radius: 50%;
}

.dot.green {
  background: #20ad77;
}

.dot.orange {
  background: #f39a16;
}

.dot.red {
  background: #e3484f;
}

.dot.gray {
  background: #b5bec9;
}

/* =========================================================
   TABLE CARD
========================================================= */

.ren-stock-table-card {
  overflow: hidden;

  border: 1px solid #e0e7ef;
  border-radius:
    0
    0
    10px
    10px;

  background: #ffffff;

  box-shadow:
    0 2px 8px
    rgba(
      15,
      23,
      42,
      0.035
    );
}

.ren-table-topbar {
  min-height: 48px;

  display: flex;
  align-items: center;

  gap: 12px;

  padding: 0 13px;

  border-bottom: 1px solid #e7ebf0;
}

.ren-table-topbar > div:first-child {
  display: flex;
  align-items: baseline;

  gap: 4px;
}

.ren-table-topbar strong {
  color: #344054;

  font-size: 10px;
}

.ren-table-topbar span {
  color: #8a96a5;

  font-size: 8px;
}

.ren-selected-info {
  padding: 5px 8px;

  border-radius: 5px;

  background: #eef5fd;

  color: #286fc7 !important;

  font-size: 8px !important;
  font-weight: 700;
}

.ren-table-pdf-button {
  margin-left: auto;

  height: 31px;

  display: flex;
  align-items: center;

  gap: 5px;

  padding: 0 9px;

  border: 1px solid #e0e5eb;
  border-radius: 6px;

  background: #ffffff;

  color: #596779;

  font-family: inherit;

  font-size: 8px;
  font-weight: 650;

  cursor: pointer;
}

.ren-table-pdf-button:hover {
  border-color: #c8d4df;

  background: #f8fafc;
}

.ren-table-pdf-button svg {
  font-size: 14px;
}

/* =========================================================
   TABLE
========================================================= */

.ren-table-scroll {
  width: 100%;

  overflow-x: auto;
}

.ren-stock-table {
  width: 100%;

  min-width: 1120px;

  border-collapse: collapse;

  table-layout: fixed;
}

.ren-stock-table th,
.ren-stock-table td {
  border-right: 1px solid #edf0f3;
  border-bottom: 1px solid #e8edf1;
}

.ren-stock-table th:last-child,
.ren-stock-table td:last-child {
  border-right: 0;
}

.ren-stock-table th {
  height: 50px;

  padding: 0 9px;

  background: #fafbfd;

  color: #596779;

  font-size: 8px;
  font-weight: 780;

  text-align: left;

  white-space: nowrap;
}

.ren-stock-table th small {
  display: block;

  margin-top: 2px;

  color: #9aa5b2;

  font-size: 7px;
  font-weight: 550;
}

.ren-stock-table td {
  height: 64px;

  padding: 0 9px;

  background: #ffffff;

  color: #536174;

  font-size: 8px;

  vertical-align: middle;
}

.ren-stock-table tbody tr:hover td {
  background: #f9fbfd;
}

.ren-stock-table tbody tr.selected-row td {
  background: #f1f7fd;
}

.ren-stock-table th:nth-child(1),
.ren-stock-table td:nth-child(1) {
  width: 34px;

  text-align: center;
}

.ren-stock-table th:nth-child(2) {
  width: 215px;
}

.ren-stock-table th:nth-child(3) {
  width: 82px;
}

.ren-stock-table th:nth-child(4) {
  width: 125px;
}

.ren-stock-table th:nth-child(5) {
  width: 78px;
}

.ren-stock-table th:nth-child(6) {
  width: 78px;
}

.ren-stock-table th:nth-child(7) {
  width: 58px;
}

.ren-stock-table th:nth-child(8) {
  width: 92px;
}

.ren-stock-table th:nth-child(9) {
  width: 94px;
}

.ren-stock-table th:nth-child(10) {
  width: 74px;
}

.ren-stock-table th:nth-child(11) {
  width: 90px;
}

.ren-stock-table th:nth-child(12) {
  width: 65px;
}

.ren-stock-table input[type="checkbox"] {
  width: 14px;
  height: 14px;

  margin: 0;

  accent-color: #286fc7;

  cursor: pointer;
}

.ren-product-cell {
  display: flex;
  align-items: center;

  gap: 8px;

  min-width: 0;
}

.ren-product-image {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  flex-shrink: 0;

  border: 1px solid #e2e7ed;
  border-radius: 6px;

  background: #f8fafc;

  color: #8d9baa;

  font-size: 19px;
}

.ren-product-cell strong {
  display: block;

  max-width: 175px;

  overflow: hidden;

  color: #263449;

  font-size: 8px;
  font-weight: 700;

  line-height: 1.35;

  text-overflow: ellipsis;
}

.ren-code {
  color: #657387;

  font-size: 8px;

  font-weight: 600;
}

.stock-normal {
  color: #18a36f;
}

.stock-low {
  color: #e99013;
}

.stock-empty {
  color: #e23d48;
}

.profit-value {
  color: #159b71;

  font-size: 9px;
}

.ren-status {
  min-height: 23px;

  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 0 7px;

  border-radius: 5px;

  font-size: 7px;
  font-weight: 700;

  white-space: nowrap;
}

.ren-status i {
  width: 5px;
  height: 5px;

  border-radius: 50%;
}

.ren-status.normal {
  background: #eaf8f1;

  color: #15835e;
}

.ren-status.normal i {
  background: #20a975;
}

.ren-status.low {
  background: #fff5e6;

  color: #dc870c;
}

.ren-status.low i {
  background: #f39a16;
}

.ren-status.empty {
  background: #ffeded;

  color: #d73d48;
}

.ren-status.empty i {
  background: #e3484f;
}

.ren-status.passive {
  background: #f0f2f4;

  color: #778292;
}

.ren-status.passive i {
  background: #aab3bd;
}

.ren-row-actions {
  display: flex;
  align-items: center;

  gap: 2px;
}

.ren-row-actions button {
  width: 27px;
  height: 27px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 5px;

  background: transparent;

  color: #7d8998;

  cursor: pointer;
}

.ren-row-actions button:hover {
  background: #edf3f9;

  color: #286fc7;
}

.ren-row-actions svg {
  font-size: 15px;
}

.ren-empty-table {
  height: 240px !important;

  text-align: center !important;
}

.ren-empty-table svg {
  display: block;

  margin: 0 auto 8px;

  color: #aab4c0;

  font-size: 28px;
}

.ren-empty-table strong {
  display: block;

  color: #536174;

  font-size: 10px;
}

.ren-empty-table span {
  display: block;

  margin-top: 4px;

  color: #9aa5b1;

  font-size: 8px;
}

/* =========================================================
   FOOTER
========================================================= */

.ren-table-footer {
  min-height: 56px;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 12px;

  padding: 0 13px;

  background: #ffffff;
}

.ren-table-footer > span {
  color: #8995a3;

  font-size: 8px;
}

.ren-table-footer > span strong {
  color: #536174;
}

.ren-pagination {
  display: flex;
  align-items: center;

  gap: 4px;
}

.ren-pagination button {
  width: 29px;
  height: 29px;

  display: grid;
  place-items: center;

  border: 1px solid #e0e6ed;
  border-radius: 5px;

  background: #ffffff;

  color: #69778a;

  font-family: inherit;

  font-size: 8px;

  cursor: pointer;
}

.ren-pagination button:hover:not(:disabled) {
  border-color: #bdd3eb;

  background: #f4f8fc;

  color: #286fc7;
}

.ren-pagination button.active {
  border-color: #286fc7;

  background: #286fc7;

  color: #ffffff;
}

.ren-pagination button:disabled {
  opacity: 0.45;

  cursor: not-allowed;
}

.ren-table-footer select {
  justify-self: end;

  height: 31px;

  padding: 0 8px;

  border: 1px solid #dce4ec;
  border-radius: 6px;

  outline: none;

  background: #ffffff;

  color: #657286;

  font-family: inherit;

  font-size: 8px;
}

/* =========================================================
   PRINT / PDF
========================================================= */

@media print {
  @page {
    size: landscape;
    margin: 10mm;
  }

  body {
    background: #ffffff !important;
  }

  .ren-stock-list {
    padding: 0;

    background: #ffffff;
  }

  .ren-stock-list-header {
    margin-bottom: 12px;
  }

  .ren-stock-header-actions,
  .ren-stock-toolbar,
  .ren-filter-panel,
  .ren-stock-tabs,
  .ren-table-topbar,
  .ren-table-footer,
  .ren-row-actions,
  .ren-stock-table th:first-child,
  .ren-stock-table td:first-child {
    display: none !important;
  }

  .ren-stock-summary {
    grid-template-columns:
      repeat(4, 1fr);
  }

  .ren-stock-table-card {
    border: 1px solid #d9dfe6;

    box-shadow: none;
  }

  .ren-stock-table {
    min-width: 0;
  }

  .ren-stock-table th,
  .ren-stock-table td {
    font-size: 8px;
  }
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1200px) {
  .ren-stock-list-header {
    align-items: flex-start;

    flex-direction: column;
  }

  .ren-stock-header-actions {
    justify-content: flex-start;
  }

  .ren-stock-summary {
    grid-template-columns:
      repeat(
        2,
        minmax(0, 1fr)
      );
  }
}

@media (max-width: 700px) {
  .ren-stock-list {
    padding:
      20px
      14px
      30px;
  }

  .ren-stock-header-actions {
    width: 100%;
  }

  .ren-stock-header-actions
  > * {
    flex: 1;
  }

  .ren-stock-summary {
    grid-template-columns: 1fr;
  }

  .ren-stock-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .ren-stock-search {
    width: 100%;
  }

  .ren-filter-panel {
    flex-direction: column;
    align-items: stretch;
  }

  .ren-filter-panel > div {
    width: 100%;
  }

  .ren-table-footer {
    grid-template-columns: 1fr;

    padding: 10px;
  }

  .ren-pagination {
    justify-content: center;
  }

  .ren-table-footer select {
    justify-self: start;
  }
}

/* =========================================================
   REN ERP — STOK LİSTESİ YAZI BOYUTU
   Kategoriler ekranı standardı
========================================================= */

.ren-stock-list {
  font-size: 12px;
}

.ren-stock-list-header h1 {
  font-size: 21px !important;
}

.ren-stock-list-header p {
  font-size: 12px !important;
}

.ren-stock-breadcrumb {
  font-size: 11px !important;
}


/* ÖZET KARTLARI */

.ren-stock-summary-card span {
  font-size: 11px !important;
}

.ren-stock-summary-card strong {
  font-size: 20px !important;
}

.ren-stock-summary-card small {
  font-size: 10px !important;
}


/* ARAMA */

.ren-stock-search input {
  font-size: 13px !important;
}


/* FİLTRE */

.ren-filter-button {
  font-size: 12px !important;
}

.ren-filter-panel label {
  font-size: 11px !important;
}

.ren-filter-panel select {
  font-size: 12px !important;
}


/* SEKME */

.ren-stock-tabs button {
  font-size: 12px !important;
}

.ren-stock-tabs button b {
  font-size: 10px !important;
}


/* TABLO BAŞLIKLARI */

.ren-stock-table thead th {
  font-size: 11px !important;

  font-weight: 700 !important;
}

.ren-stock-table thead th small {
  font-size: 9px !important;
}


/* TABLO YAZILARI */

.ren-stock-table tbody td {
  font-size: 12px !important;
}

.ren-stock-table tbody td strong {
  font-size: 12px !important;
}

.ren-product-cell strong {
  max-width: 230px;

  font-size: 13px !important;

  font-weight: 600 !important;
}

.ren-code {
  font-size: 11px !important;
}

.ren-stock-table td small {
  font-size: 10px !important;
}


/* STOK DURUMU */

.ren-status {
  font-size: 11px !important;

  min-height: 26px;
}


/* İŞLEM BUTONLARI */

.ren-row-actions > button,
.ren-row-actions > div > button {
  font-size: 15px;
}


/* TABLO ALT */

.ren-table-topbar > div:first-child strong {
  font-size: 13px !important;
}

.ren-table-topbar > div:first-child span {
  font-size: 11px !important;
}

.ren-table-footer > span {
  font-size: 11px !important;
}

.ren-table-footer select {
  font-size: 10px !important;
}

.stock-product-name-link {
  border: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  color: #303943;
  font: inherit;
  font-weight: 700;
  font-size: 12px;
  text-align: left;
  cursor: pointer;
}

.stock-product-name-link:hover {
  color: #286fc7;
  text-decoration: underline;
}