.cash-bank-page {
  min-height: 100vh;
  background: #f5f7fa;
  color: #172033;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

.cash-bank-container {
  max-width: 1500px;
  margin: 0 auto;
  padding: 30px 32px 40px;
  box-sizing: border-box;
}


/* HEADER */

.cash-bank-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.cash-bank-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  color: #8a95a5;
  font-size: 11px;
}

.cash-bank-breadcrumb strong {
  color: #7c8797;
}

.cash-bank-header h1 {
  margin: 0;
  color: #172033;
  font-size: 27px;
  font-weight: 750;
  letter-spacing: -0.4px;
}

.cash-bank-header p {
  margin: 7px 0 0;
  color: #8994a3;
  font-size: 12px;
}

.cash-bank-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cash-bank-secondary-button,
.cash-bank-primary-button {
  height: 40px;
  padding: 0 14px;
  border-radius: 7px;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.cash-bank-secondary-button {
  border: 1px solid #dce3eb;
  background: #fff;
  color: #526073;
}

.cash-bank-primary-button {
  border: 1px solid #286fc7;
  background: #286fc7;
  color: #fff;
}


/* SUMMARY */

.cash-bank-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 11px;
  margin-bottom: 15px;
}

.cash-bank-summary-card {
  min-height: 91px;
  padding: 15px 17px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 1px solid #e1e7ee;
  border-radius: 8px;
  background: #fff;
}

.cash-bank-summary-card span {
  color: #8b96a5;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .25px;
}

.cash-bank-summary-card strong {
  margin-top: 6px;
  color: #263247;
  font-size: 19px;
  font-weight: 750;
}

.cash-bank-summary-card small {
  margin-top: 4px;
  color: #a0a8b3;
  font-size: 8px;
}

.cash-bank-summary-card.highlight {
  border-color: #cbdced;
  background: #f8fbff;
}

.cash-bank-summary-card.highlight strong {
  color: #286fc7;
}


/* TABS */

.cash-bank-tabs {
  height: 46px;
  display: flex;
  align-items: stretch;
  gap: 3px;
  border-bottom: 1px solid #dfe5eb;
}

.cash-bank-tabs button {
  position: relative;
  padding: 0 18px;
  border: 0;
  background: transparent;
  color: #8994a3;
  font-family: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.cash-bank-tabs button.active {
  color: #286fc7;
}

.cash-bank-tabs button.active::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: -1px;
  height: 2px;
  border-radius: 2px;
  background: #286fc7;
}


/* CARD */

.cash-bank-card {
  overflow: hidden;
  border: 1px solid #e1e7ee;
  border-top: 0;
  background: #fff;
}

.cash-bank-card-header {
  min-height: 72px;
  padding: 14px 16px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid #e8edf2;
}

.cash-bank-card-header > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cash-bank-card-header strong {
  color: #354257;
  font-size: 12px;
  font-weight: 750;
}

.cash-bank-card-header span {
  color: #9aa4b0;
  font-size: 9px;
}

.cash-bank-small-primary {
  height: 35px;
  padding: 0 12px;
  border: 1px solid #286fc7;
  border-radius: 6px;
  background: #286fc7;
  color: #fff;
  font-family: inherit;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}


/* ACCOUNT GRID */

.cash-bank-account-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11px;
  padding: 15px;
}

.cash-bank-account {
  min-height: 190px;
  padding: 15px;
  box-sizing: border-box;
  border: 1px solid #e2e7ed;
  border-radius: 8px;
  background: #fff;
}

.cash-bank-account:hover {
  border-color: #cbd9e8;
}

.cash-bank-account-top {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cash-bank-account-icon {
  width: 37px;
  height: 37px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #edf4fc;
  color: #286fc7;
  font-size: 16px;
  font-weight: 800;
}

.cash-bank-account-top > div:last-child {
  min-width: 0;
}

.cash-bank-account-top strong {
  display: block;
  overflow: hidden;
  color: #354257;
  font-size: 10px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cash-bank-account-top span {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #9aa4b0;
  font-size: 8px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cash-bank-account-balance {
  margin-top: 24px;
  color: #263247;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -.3px;
}

.cash-bank-iban {
  margin-top: 5px;
  color: #9aa4b0;
  font-family: Consolas, monospace;
  font-size: 8px;
}

.cash-bank-account-footer {
  margin-top: 21px;
  padding-top: 11px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #edf0f3;
}

.cash-bank-account-footer > div {
  display: flex;
  gap: 5px;
}

.cash-bank-account-footer button {
  height: 27px;
  padding: 0 8px;
  border: 1px solid #dce3eb;
  border-radius: 5px;
  background: #fff;
  color: #596678;
  font-family: inherit;
  font-size: 8px;
  font-weight: 700;
  cursor: pointer;
}

.cash-bank-account-footer button:hover {
  border-color: #a9c5e6;
  color: #286fc7;
}

.cash-bank-account-footer button.danger:hover {
  border-color: #e5b5b0;
  color: #bd4d43;
  background: #fff8f7;
}

.cash-bank-status {
  color: #2b8967 !important;
  font-size: 8px !important;
  font-weight: 700;
}


/* TABLE */

.cash-bank-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.cash-bank-table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
}

.cash-bank-table thead th {
  height: 40px;
  padding: 0 13px;
  background: #fafbfd;
  border-bottom: 1px solid #e5eaf0;
  color: #8a95a4;
  text-align: left;
  white-space: nowrap;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .25px;
}

.cash-bank-table tbody td {
  height: 59px;
  padding: 7px 13px;
  border-bottom: 1px solid #edf1f4;
  color: #657184;
  white-space: nowrap;
  font-size: 9px;
}

.cash-bank-table tbody tr:hover {
  background: #fafcff;
}

.cash-bank-table tbody td strong {
  color: #3f4c60;
  font-size: 9px;
}

.money-head {
  text-align: right !important;
}

.cash-bank-money {
  text-align: right !important;
}

.cash-bank-money strong {
  font-size: 9px !important;
}

.cash-bank-direction {
  display: inline-flex;
  align-items: center;
  min-height: 23px;
  padding: 0 8px;
  border-radius: 5px;
  font-size: 8px;
  font-weight: 750;
}

.cash-bank-direction.income {
  background: #eef8f4;
  color: #2b8967;
}

.cash-bank-direction.expense {
  background: #fff0ef;
  color: #bd4d43;
}


/* EMPTY */

.cash-bank-empty {
  height: 230px !important;
  text-align: center !important;
}

.cash-bank-empty > div {
  width: 45px;
  height: 45px;
  margin: 0 auto 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f4f7;
  color: #98a2b0;
  font-size: 20px;
}

.cash-bank-empty strong {
  display: block;
  color: #354257;
  font-size: 12px !important;
}

.cash-bank-empty span {
  display: block;
  margin-top: 5px;
  color: #929cab;
  font-size: 9px;
}


/* INTEGRATION */

.cash-bank-integration-info {
  min-height: 82px;
  margin-top: 15px;
  padding: 14px 16px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid #dce5ef;
  border-radius: 8px;
  background: #f8fbff;
}

.cash-bank-integration-icon {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: #e9f2fc;
  color: #286fc7;
  font-size: 17px;
  font-weight: 800;
}

.cash-bank-integration-info > div:nth-child(2) {
  flex: 1;
}

.cash-bank-integration-info strong {
  display: block;
  color: #354257;
  font-size: 10px;
}

.cash-bank-integration-info p {
  margin: 4px 0 0;
  color: #8b96a5;
  font-size: 8px;
  line-height: 1.5;
}

.cash-bank-coming {
  padding: 6px 8px;
  border-radius: 5px;
  background: #edf4fc;
  color: #286fc7;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .3px;
}


/* MODAL */

.cash-bank-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  background: rgba(18, 27, 40, .38);
}

.cash-bank-modal {
  width: min(510px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 20px 60px rgba(20, 35, 55, .18);
}

.cash-bank-modal-header {
  min-height: 65px;
  padding: 13px 17px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e8edf2;
}

.cash-bank-modal-header > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cash-bank-modal-header strong {
  color: #354257;
  font-size: 13px;
}

.cash-bank-modal-header span {
  color: #9aa4b0;
  font-size: 9px;
}

.cash-bank-modal-header > button {
  width: 29px;
  height: 29px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: #f1f4f7;
  color: #697588;
  font-size: 18px;
  cursor: pointer;
}

.cash-bank-modal form {
  padding: 18px;
}

.cash-bank-form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 13px;
}

.cash-bank-form-group label {
  color: #657184;
  font-size: 9px;
  font-weight: 750;
}

.cash-bank-form-group input,
.cash-bank-form-group select,
.cash-bank-form-group textarea {
  width: 100%;
  min-height: 38px;
  padding: 0 10px;
  box-sizing: border-box;
  border: 1px solid #dce3eb;
  border-radius: 6px;
  outline: none;
  background: #fafbfd;
  color: #354257;
  font-family: inherit;
  font-size: 10px;
}

.cash-bank-form-group textarea {
  min-height: 76px;
  padding: 10px;
  resize: vertical;
}

.cash-bank-form-group input:focus,
.cash-bank-form-group select:focus,
.cash-bank-form-group textarea:focus {
  border-color: #83aee0;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(40, 111, 199, .07);
}

.cash-bank-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.cash-bank-modal-footer {
  margin-top: 7px;
  padding-top: 14px;
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  border-top: 1px solid #edf0f3;
}

.cash-bank-modal-cancel,
.cash-bank-modal-submit {
  height: 37px;
  padding: 0 14px;
  border-radius: 6px;
  font-family: inherit;
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}

.cash-bank-modal-cancel {
  border: 1px solid #dce3eb;
  background: #fff;
  color: #687588;
}

.cash-bank-modal-submit {
  border: 1px solid #286fc7;
  background: #286fc7;
  color: #fff;
}


/* RESPONSIVE */

@media (max-width: 1200px) {
  .cash-bank-summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .cash-bank-account-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 750px) {
  .cash-bank-container {
    padding: 20px 14px 30px;
  }

  .cash-bank-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .cash-bank-header-actions {
    width: 100%;
  }

  .cash-bank-header-actions button {
    flex: 1;
  }

  .cash-bank-summary {
    grid-template-columns: 1fr 1fr;
  }

  .cash-bank-account-grid {
    grid-template-columns: 1fr;
  }

  .cash-bank-form-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .cash-bank-summary {
    grid-template-columns: 1fr;
  }

  .cash-bank-card-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .cash-bank-small-primary {
    width: 100%;
  }
}

/* =========================================================
   HESAP İŞLEMLERİ - SİL BUTONU
========================================================= */

.cash-bank-account-footer button.danger {
  min-width: 58px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;

  padding: 0 10px;

  border: 1px solid #efb7b3;
  border-radius: 5px;

  background: #fff;
  color: #d9534f;

  font-family: inherit;
  font-size: 11px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background .15s ease,
    border-color .15s ease,
    color .15s ease;
}

.cash-bank-account-footer button.danger:hover {
  background: #fff4f3;
  border-color: #df8f89;
  color: #c83f3a;
}

.cash-bank-account-footer button.danger:active {
  background: #ffe9e7;
}


/* HESAP AKSİYONLARININ GENEL DÜZENİ */

.cash-bank-account-footer > div {
  display: flex;
  align-items: center;
  gap: 7px;
}

.cash-bank-account-footer > div button {
  min-width: 58px;
  height: 32px;
  padding: 0 10px;

  border: 1px solid #d9e0e8;
  border-radius: 5px;

  background: #fff;
  color: #52606d;

  font-family: inherit;
  font-size: 10px;
  font-weight: 600;

  cursor: pointer;
}

.cash-bank-account-footer > div button:hover {
  background: #f7f9fb;
  border-color: #c6ced8;
}


/* DÜZENLE */

.cash-bank-account-footer > div button:not(.danger) {
  color: #286fc7;
}


/* HAREKET */

.cash-bank-account-footer > div button:first-child {
  color: #52606d;
}


/* MOBİL */

@media (max-width: 650px) {
  .cash-bank-account-footer > div {
    flex-wrap: wrap;
  }

  .cash-bank-account-footer > div button {
    min-width: 54px;
  }
}